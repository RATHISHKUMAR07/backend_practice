package Ds.Graphs;

import java.util.LinkedList;
//


public class Graph {
	
	int V;
	LinkedList<Integer> adj[];
	Graph(int V){
		this.V = V;
		adj = new LinkedList[V];
		for(int i=0;i<V;i++) {
			adj[i] = new LinkedList<Integer>();
		}
	}
	
	
	void addEdge(int index, int vertice) {
		adj[index].add(vertice);
	}

	public static void main(String[] args) {}

}
