package Ds.Graphs;

import java.util.*;
//


public class Graph {
	
	int V;
	LinkedList<Integer> adj[];
	Graph(int V){
		this.V = V;
		adj = new LinkedList[V];
		for(int i=0;i<V;i++) {
			adj[i] = new LinkedList<Integer>();
		}
	}
	
	
	void addEdge(int index, int vertice) {
		adj[index].add(vertice);
	}
	
	void BFS(int vertice) {
		boolean[] visited = new boolean[V];
		LinkedList<Integer> queue = new LinkedList<Integer>();
		
		queue.add(vertice);
		
		visited[vertice] = true;
		
		while(!queue.isEmpty()) {

			int data = queue.poll();
			System.out.print(data + " ");
			System.out.println(queue);

			
			for(int dataAdj : adj[data]) {
				if(visited[dataAdj] == false) {
					visited[dataAdj] = true;
					queue.add(dataAdj);
				}
			}
			
		}
	}

	public static void main(String[] args) {
		Graph g=new Graph(4);
		g.addEdge(0,1);
		g.addEdge(0,2);
		g.addEdge(1,2);
		g.addEdge(2,0);
		g.addEdge(2,3);
		g.addEdge(3,3);
		
		g.BFS(2);
	}

}
