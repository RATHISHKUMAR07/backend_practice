package Medium;

public class CountofSubstringsContainingVowelAndKConsonants {

	public static void main(String[] args) {
		System.out.println(countOfSubstrings("aeiou", 0));
	}
	
public static long countOfSubstrings(String word, int k) {
        
        long count = 0;
        for(int i=0;i<word.length()-4;i++){
            if(isVowel(i,i+5, word, k)){
                count++;
            }
        }
        return count;
    }
    public static  boolean isVowel(int i, int j, String word, int k){
        for(int i=i;i<j;i++){
            if(!(word.charAt(i) == ('a' || 'e' || 'i' || 'o' || 'u'))){
                k--;
            }
        }
        if(k == 0)
            return true;
        else
            return false;
    } 

}
