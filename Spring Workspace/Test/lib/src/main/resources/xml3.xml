<?xml version="1.0" encoding="UTF-8"?>  
<beans  
    xmlns="http://www.springframework.org/schema/beans"  
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"  
    xmlns:p="http://www.springframework.org/schema/p"  
    xsi:schemaLocation="http://www.springframework.org/schema/beans  
               http://www.springframework.org/schema/beans/spring-beans-3.0.xsd"> 
            
            <!-- Example 4-->
            <bean id="address" class="Example4.Address">
				<constructor-arg value="Vellore"></constructor-arg>
				<constructor-arg value="Tamilnadu"></constructor-arg>
				<constructor-arg value="India"></constructor-arg>
			</bean>   
			
			<bean id="empBean" class="Example4.Employee">
				<constructor-arg value="100001" type="int"></constructor-arg>
				<constructor-arg value="Rathish"></constructor-arg>
				<constructor-arg>
					<ref bean="address"></ref>
				</constructor-arg>
			</bean>
			
			<!-- Example 6-->
			<bean id="ans1" class="Example6.Answer">
				<constructor-arg value="1"></constructor-arg>
				<constructor-arg value="Java is a Programming language"></constructor-arg>
				<constructor-arg value="Naveen"></constructor-arg>
			</bean>
			<bean id="ans2" class="Example6.Answer">
				<constructor-arg value="2"></constructor-arg>
				<constructor-arg value="Java is a Platform"></constructor-arg>
				<constructor-arg value="Chandhini"></constructor-arg>
			</bean>
			<bean id="ans3" class="Example6.Answer">
				<constructor-arg value="3"></constructor-arg>
				<constructor-arg value="Java is a OOPs"></constructor-arg>
				<constructor-arg value="Nishanth"></constructor-arg>
			</bean>
			
			<bean id="queBean" class="Example6.Question">
				<constructor-arg value="101"></constructor-arg>
				<constructor-arg value="Rathish"></constructor-arg>
				<constructor-arg>
					<list>
						<ref bean="ans1" />
						<ref bean="ans2" />
						<ref bean="ans3" />
					</list>
				</constructor-arg>
			</bean>

</beans>