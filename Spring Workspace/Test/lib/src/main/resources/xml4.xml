<?xml version="1.0" encoding="UTF-8"?>  
<beans  
    xmlns="http://www.springframework.org/schema/beans"  
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"  
    xmlns:p="http://www.springframework.org/schema/p"  
    xsi:schemaLocation="http://www.springframework.org/schema/beans  
               http://www.springframework.org/schema/beans/spring-beans-3.0.xsd"> 
            
            <!-- Example 7-->
            <bean id="qBean" class="Example7.Question">
				<constructor-arg value="1"></constructor-arg>
				<constructor-arg value="Rathish"></constructor-arg>
				<constructor-arg>
					<map>
						<entry key="Java" value="Naveen"></entry>
						<entry key="Java is " value="Nishanth"></entry>
						<entry key="Java is Programming" value="Chandhini"></entry>
					</map>
				</constructor-arg>
			</bean>
			
			<!-- Example 8-->
			<bean id="answer1" class="Example8.Answer">
				<constructor-arg value="1"></constructor-arg>
				<constructor-arg value="Java is Good"></constructor-arg>
				<constructor-arg value="12/12/2001"></constructor-arg>
			</bean>
			<bean id="answer2" class="Example8.Answer">
				<constructor-arg value="2"></constructor-arg>
				<constructor-arg value="Java is Bad"></constructor-arg>
				<constructor-arg value="12/12/2000"></constructor-arg>
			</bean>
			
			<bean id="user1" class="Example8.User">
				<constructor-arg value="1"></constructor-arg>
				<constructor-arg value="Rathish Kumar"></constructor-arg>
				<constructor-arg value="Rathish@gmail.com"></constructor-arg>
			</bean>
			<bean id="user2" class="Example8.User">
				<constructor-arg value="2"></constructor-arg>
				<constructor-arg value="Naveen Kumar"></constructor-arg>
				<constructor-arg value="Naveen@gmail.com"></constructor-arg>
			</bean>
			
			<bean id="q" class="Example8.Question">
				<constructor-arg value="1"></constructor-arg>
				<constructor-arg value="What's Java"></constructor-arg>
				<constructor-arg>
					<map>
						<entry key-ref="answer1" value-ref="user1"></entry>	
						<entry key-ref="answer2" value-ref="user2"></entry>
					</map>
				</constructor-arg>
			</bean>

            
</beans>