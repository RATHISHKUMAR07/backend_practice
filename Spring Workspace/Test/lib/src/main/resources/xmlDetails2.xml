<beans  
    xmlns="http://www.springframework.org/schema/beans"  
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"  
    xmlns:p="http://www.springframework.org/schema/p"  
    xsi:schemaLocation="http://www.springframework.org/schema/beans  
               http://www.springframework.org/schema/beans/spring-beans-3.0.xsd"> 
               
               <!-- Example 13 -->
               <bean id="Q" class="Example13.Question">
				   <property name="id" value="1"></property>
				   <property name="name" value="What's Java"></property>
				   <property name="answers">
					   <map>
						   <entry key="Java" value="Rathish"></entry>
						   	<entry key="Python" value="Naveen"></entry>
						   <entry key="C++" value="Nishanth"></entry>
					   </map>
				   </property>
			   </bean>
			   
			    <!-- Example 14 -->
			    <bean id="answer1" class="Example14.Answer">
					<property name="id" value="101"></property>
					<property name="answer" value="Java is Good"></property>
					<property name="postedDate" value="12/12/2000"></property>
				</bean>
				<bean id="answer2" class="Example14.Answer">
					<property name="id" value="101"></property>
					<property name="answer" value="Java is Bad"></property>
					<property name="postedDate" value="12/12/2000"></property>
				</bean>
				
				<bean id="user1" class="Example14.User">
					<property name="id" value="11"></property>
					<property name="name" value="Rathish"></property>
					<property name="email" value="rathish@gmail.com"></property>
				</bean>
				<bean id="user2" class="Example14.User">
					<property name="id" value="12"></property>
					<property name="name" value="Naveen"></property>
					<property name="email" value="naveen@gmail.com"></property>
				</bean>
				
				<bean id="Q1" class="Example14.Question">
					<property name="id" value="01"></property>
					<property name="name" value="Messi"></property>
					<property name="answers">
						<map>
							<entry key-ref="answer1" value-ref="user1"></entry>
							<entry key-ref="answer2" value-ref="user2"></entry>
						</map>
					</property>
				</bean>
				
				<!-- Example 15 -->
				<!-- Auto wire - ByName				
				<bean id="b" class="Example15.B"></bean>
				<bean id="a" class="Example15.A" autowire="byName"></bean>
				 -->
				<!-- Auto wire - ByType -->	
				<bean id="b1" class="Example15.B"></bean>
				<bean id="a" class="Example15.A" autowire="byType"></bean>
				
</beans>