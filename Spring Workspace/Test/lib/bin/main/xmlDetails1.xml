<beans  
    xmlns="http://www.springframework.org/schema/beans"  
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"  
    xmlns:p="http://www.springframework.org/schema/p"  
    xsi:schemaLocation="http://www.springframework.org/schema/beans  
               http://www.springframework.org/schema/beans/spring-beans-3.0.xsd"> 
               
               <!-- Example 9 -->
               <bean id="emp" class="Example9.Employee">
				   <property name="id" value="1"></property>
				   <property name="name" value="Rathish"></property>
				   <property name="city" value="Vellore"></property>
			   </bean>
			   
			   <!-- Example 10 -->
			   <bean id="e" class="Example10.Address">
				   <property name="street" value="07"></property>
				   <property name="city" value="Vellore"></property>
				   <property name="state" value="Tamilnadu"></property>
				   	<property name="country" value="India"></property>
			   </bean>
               <bean id="Emp" class="Example10.Employee">
				   <property name="id" value="1"></property>
				   <property name="name" value="Rathish"></property>
				   <property name="address" ref="e"></property>
			   </bean>
			   
			   <!-- Example 11 -->
			   <bean id="Que" class="Example11.Question">
				   <property name="id" value="101"></property>
				   <property name="name" value="Rathsih"></property>
					<property name="answers">
					   <list>
						   <value>The java is Good</value>						   
						   <value>The java is Good</value>
						   <value>The java is Good</value>
					   </list>
				   </property>
			   </bean>
			   
			   <!-- Example 12 -->
			   <bean id="ans1" class="Example12.Answer">
			   		<property name="id" value="1"></property>
				    <property name="name" value="Java"></property>
					<property name="by" value="Naveen"></property>
			   </bean>
			   <bean id="ans2" class="Example12.Answer">
			   		<property name="id" value="2"></property>
				    <property name="name" value="Python"></property>
					<property name="by" value="Nishanth"></property>
			   </bean>
			   <bean id="Q" class="Example12.Question">
				    <property name="id" value="101"></property>
				    <property name="name" value="Rathsih"></property>
					<property name="answers">
						<list>
							<ref bean="ans1"/>
							<ref bean="ans2"/>
						</list>
					</property>				
			   </bean>
</beans>