<?xml version="1.0" encoding="UTF-8"?>  
<beans  
    xmlns="http://www.springframework.org/schema/beans"  
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"  
    xmlns:p="http://www.springframework.org/schema/p"  
    xsi:schemaLocation="http://www.springframework.org/schema/beans  
               http://www.springframework.org/schema/beans/spring-beans-3.0.xsd">  
       
    <!-- Example 1 -->     
    <bean id = "Student1" class="Example1.Student">
		<property name="name" value="Rathish Kumar M"></property>
		<property name="rollNo" value="136" ></property>
	</bean>
	
	 <!-- Example 2 -->     
	<bean id="studBean" class="Example2.Student">
		<property name="rollNo" value="136"></property>
		<property name="name" value="Rathish Kumar M"></property>
		<property name="place" value="Vellore"></property>
	</bean>
	
	<!-- Example 5 -->   
	<bean id="queBean" class="Example5.Question">
		<constructor-arg value="1001" type="int"></constructor-arg>
		<constructor-arg value="What's Java"></constructor-arg>
		<constructor-arg>
			<list>
				<value>Java is a Programming language</value>
				<value>Java is a Platform</value>
				<value>Java is a OOPs</value>
			</list>
		</constructor-arg>
	</bean>

</beans>